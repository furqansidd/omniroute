datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// 1. TENANCY
// ----------------------------------------------------
model Tenant {
  id               String          @id @default(uuid())
  companyName      String
  industryType     String          @default("water") // water, milk, lpg, oil, multi
  subscriptionTier String          @default("starter") // starter, professional, enterprise
  city             String?
  status           String          @default("active") // active, suspended, cancelled
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  settings         TenantSettings?
  users            User[]
  roles            Role[]
  zones            Zone[]
  routes           Route[]
  visitPlans       VisitPlan[]
  customers        Customer[]
  products         Product[]
  warehouses       Warehouse[]
  orders           Order[]
  deliveries       Delivery[]
  recurringSchedules RecurringSchedule[]
  invoices         Invoice[]
  paymentVouchers  PaymentVoucher[]
  journalEntries   JournalEntry[]
  ledgers          Ledger[]
  locationPings    RiderLocationPing[]
  breakageLogs     BreakageWastageLog[]
  customerRates    CustomerProductRate[]
  securityLedgers  CustomerSecurityLedger[]
  stockLedgers     StockLedger[]
  messageTemplates MessageTemplate[]
  messageLogs      MessageLog[]
  productionBatches ProductionBatch[]
  subscriptionPayments SubscriptionPayment[]
  vendors          Vendor[]
  purchaseOrders   PurchaseOrder[]
  goodsReceipts    GoodsReceipt[]
  boms             BillOfMaterials[]
}

model TenantSettings {
  id              String   @id @default(uuid())
  tenantId        String   @unique
  currency        String   @default("USD")
  timezone        String   @default("UTC")
  defaultLanguage String   @default("en")
  invoicePrefix   String   @default("INV-")
  taxRate         Float    @default(0.0)
  receiptHeader   String?
  receiptFooter   String?
  supportPhone    String?

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------
// 2. IDENTITY & ACCESS (RBAC)
// ----------------------------------------------------
model User {
  id           String         @id @default(uuid())
  tenantId     String
  roleId       String
  name         String
  phone        String?
  email        String?
  passwordHash String
  status       String         @default("active") // active, inactive
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role         Role           @relation(fields: [roleId], references: [id])
  refreshTokens RefreshToken[]
  
  // Relations as supervisor/rider/staff
  supervisedZones Zone[]       @relation("SupervisorZones")
  riderVisitPlans VisitPlan[]   @relation("RiderVisitPlans")
  riderDeliveries Delivery[]    @relation("RiderDeliveries")
  riderPings      RiderLocationPing[] @relation("RiderPings")
  mobileWarehouses Warehouse[]  @relation("RiderMobileDepot")
  breakageReported BreakageWastageLog[] @relation("ReportedBy")
  breakageLiability BreakageWastageLog[] @relation("ResponsibleRider")
  producedBatches   ProductionBatch[]

  @@unique([tenantId, email])
  @@unique([tenantId, phone])
  @@index([tenantId])
}

model Role {
  id           String           @id @default(uuid())
  tenantId     String?          // null for platform system default roles
  name         String
  description  String?
  isSystemRole Boolean          @default(false)
  createdAt    DateTime         @default(now())

  tenant       Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users        User[]
  permissions  RolePermission[]

  @@index([tenantId])
}

model Permission {
  id          String           @id @default(uuid())
  module      String           // tenants, users, roles, customers, products, zones, routes, orders, stock, empties, finance, notifications, reports, breakage, settings
  action      String           // create, read, update, delete, approve, export, issue_credit_note, override_price, view_pnl
  description String?

  roles       RolePermission[]

  @@unique([module, action])
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ----------------------------------------------------
// 3. GEOGRAPHY & ROUTING
// ----------------------------------------------------
model Zone {
  id                   String   @id @default(uuid())
  tenantId             String
  name                 String
  description          String?
  geoBoundary          String?  // Polygon JSON coordinates string
  assignedSupervisorId String?

  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supervisor           User?    @relation("SupervisorZones", fields: [assignedSupervisorId], references: [id])
  routes               Route[]
  customers            Customer[]

  @@index([tenantId])
}

model Route {
  id            String      @id @default(uuid())
  tenantId      String
  zoneId        String
  name          String
  sequenceOrder Int         @default(1)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  zone          Zone        @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  visitPlans    VisitPlan[]

  @@index([tenantId])
  @@index([zoneId])
}

model VisitPlan {
  id           String   @id @default(uuid())
  tenantId     String
  routeId      String
  riderId      String
  dayOfWeek    Int      // 0 (Sun) - 6 (Sat)
  scheduleType String   @default("daily") // daily, alternate_day, weekly
  status       String   @default("active")
  createdAt    DateTime @default(now())

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  route        Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  rider        User     @relation("RiderVisitPlans", fields: [riderId], references: [id])

  @@index([tenantId])
  @@index([routeId])
  @@index([riderId])
}

// ----------------------------------------------------
// 4. CUSTOMERS
// ----------------------------------------------------
model Customer {
  id           String   @id @default(uuid())
  tenantId     String
  zoneId       String?
  name         String
  phone        String
  email        String?
  address      String
  geoLat       Float?
  geoLng       Float?
  stopNumber   Int?     // Stop sequence within zone (Stop 1, 2, 3...)
  customerType String   @default("residential") // residential, commercial, corporate
  status       String   @default("active") // active, sleeping, churned
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant          Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  zone            Zone?                   @relation(fields: [zoneId], references: [id])
  productRates    CustomerProductRate[]
  securityLedgers CustomerSecurityLedger[]
  orders          Order[]
  recurringSchedules RecurringSchedule[]
  invoices        Invoice[]
  paymentVouchers PaymentVoucher[]
  ledgers         Ledger[]

  @@index([tenantId])
  @@index([zoneId])
}


model CustomerProductRate {
  id          String   @id @default(uuid())
  tenantId    String
  customerId  String
  productId   String
  customPrice Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
  @@index([tenantId])
}

model CustomerSecurityLedger {
  id            String   @id @default(uuid())
  tenantId      String
  customerId    String
  productId     String   // Returnable container product (bottle/cylinder)
  qtyHeld       Int      @default(0)
  depositAmount Float    @default(0.0)
  updatedAt     DateTime @updatedAt

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
  @@index([tenantId])
}

// ----------------------------------------------------
// 5. PRODUCTS & INVENTORY
// ----------------------------------------------------
model Product {
  id                      String   @id @default(uuid())
  tenantId                String
  name                    String
  sku                     String
  category                String   // water_bottle, milk, lpg_cylinder, oil_can, oil_drum
  productType             String   @default("finished_good") // raw_material, packaging, finished_good, returnable_container
  unit                    String   @default("unit") // unit, liter, kg
  price                   Float
  costPrice               Float    @default(0.0)
  depositPrice            Float    @default(0.0)
  reorderLevel            Int      @default(10)
  isReturnableContainer   Boolean  @default(false)
  serialTrackingRequired  Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  tenant                  Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stockLedgers            StockLedger[]
  orderItems              OrderItem[]
  customerRates           CustomerProductRate[]
  securityLedgers         CustomerSecurityLedger[]
  recurringSchedules      RecurringSchedule[]
  breakageLogs            BreakageWastageLog[]
  invoiceItems            InvoiceItem[]
  productionBatches       ProductionBatch[]
  bomsAsFinished          BillOfMaterials[]       @relation("FinishedProductBOM")
  bomItems                BOMItem[]
  poItems                 PurchaseOrderItem[]
  grnItems                GoodsReceiptItem[]

  @@unique([tenantId, sku])
  @@index([tenantId])
}

model Warehouse {
  id                 String        @id @default(uuid())
  tenantId           String
  name               String
  location           String?
  isRiderMobileDepot Boolean       @default(false)
  riderId            String?

  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rider              User?         @relation("RiderMobileDepot", fields: [riderId], references: [id])
  stockLedgers       StockLedger[]
  breakageLogs       BreakageWastageLog[]
  productionBatches  ProductionBatch[]

  @@index([tenantId])
}

model StockLedger {
  id              String   @id @default(uuid())
  tenantId        String
  productId       String
  warehouseId     String?
  riderId         String?
  qty             Int
  transactionType String   // load, deliver, return, breakage, wastage, transfer
  referenceId     String?
  createdAt       DateTime @default(now())

  tenant          Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product         Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse       Warehouse? @relation(fields: [warehouseId], references: [id])

  @@index([tenantId])
  @@index([productId])
}

// ----------------------------------------------------
// 6. ORDERS & DELIVERIES
// ----------------------------------------------------
model Order {
  id          String      @id @default(uuid())
  tenantId    String
  customerId  String
  orderNumber String
  orderType   String      @default("on_demand") // scheduled, on_demand, recurring_subscription
  status      String      @default("pending") // pending, assigned, out_for_delivery, delivered, cancelled
  totalAmount Float       @default(0.0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer    Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items       OrderItem[]
  delivery    Delivery?

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@index([customerId])
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  productId  String
  qty        Int
  unitPrice  Float
  totalPrice Float

  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])
}

model Delivery {
  id                  String    @id @default(uuid())
  tenantId            String
  orderId             String    @unique
  riderId             String
  scheduledDate       DateTime
  status              String    @default("pending") // pending, delivered, failed, rescheduled
  deliveredQty        Int       @default(0)
  emptiesCollectedQty Int       @default(0)
  cashCollected       Float     @default(0.0)
  geoLat              Float?
  geoLng              Float?
  eSignatureUrl       String?
  failureReason       String?
  deliveredAt         DateTime?
  createdAt           DateTime  @default(now())

  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order               Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rider               User      @relation("RiderDeliveries", fields: [riderId], references: [id])

  @@index([tenantId])
  @@index([riderId])
}

model RecurringSchedule {
  id          String   @id @default(uuid())
  tenantId    String
  customerId  String
  productId   String
  qty         Int      @default(1)
  frequency   String   // daily, alternate_day, weekly, monthly
  nextRunDate DateTime
  status      String   @default("active") // active, paused, cancelled
  createdAt   DateTime @default(now())

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([customerId])
}

// ----------------------------------------------------
// 7. FINANCE & LEDGERS
// ----------------------------------------------------
model Invoice {
  id            String        @id @default(uuid())
  tenantId      String
  customerId    String
  invoiceNumber String
  billingPeriod String        // e.g. "2026-08"
  subtotal      Float
  taxAmount     Float         @default(0.0)
  totalAmount   Float
  paidAmount    Float         @default(0.0)
  status        String        @default("unpaid") // unpaid, partial, paid, overdue, cancelled
  dueDate       DateTime
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items         InvoiceItem[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([customerId])
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  productId   String?
  description String
  qty         Int
  unitPrice   Float
  totalPrice  Float

  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@index([productId])
}

model PaymentVoucher {
  id              String   @id @default(uuid())
  tenantId        String
  customerId      String?
  vendorId        String?
  voucherNumber   String
  voucherType     String   @default("receipt") // receipt, payment, debit_note, credit_note
  category        String   @default("customer_collection") // customer_collection, fuel_expense, rider_payout, supplier_payment, equipment_purchase, other
  accountName     String?  // Cash, Bank, Expense Category
  amount          Float
  paymentMethod   String   @default("cash") // cash, bank_transfer, check, card
  referenceNumber String?
  notes           String?
  createdAt       DateTime @default(now())

  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer        Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vendor          Vendor?   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([tenantId, voucherNumber])
  @@index([tenantId])
  @@index([customerId])
  @@index([vendorId])
}

model JournalEntry {
  id          String   @id @default(uuid())
  tenantId    String
  entryNumber String
  entryDate   DateTime @default(now())
  description String
  reference   String?
  createdAt   DateTime @default(now())

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ledgers     Ledger[]

  @@unique([tenantId, entryNumber])
  @@index([tenantId])
}

model Ledger {
  id              String        @id @default(uuid())
  tenantId        String
  customerId      String?
  vendorId        String?
  journalEntryId  String
  accountCategory String        @default("asset") // asset, liability, equity, revenue, expense
  accountName     String        @default("General") // Accounts Receivable, Accounts Payable, Cash, Delivery Sales, Operating Expense, Container Deposit
  description     String?
  debit           Float         @default(0.0)
  credit          Float         @default(0.0)
  runningBalance  Float         @default(0.0)
  createdAt       DateTime      @default(now())

  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer        Customer?     @relation(fields: [customerId], references: [id])
  vendor          Vendor?       @relation(fields: [vendorId], references: [id])
  journalEntry    JournalEntry  @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([customerId])
  @@index([vendorId])
}

// ----------------------------------------------------
// 8. RIDERS & TRACKING
// ----------------------------------------------------
model RiderLocationPing {
  id           String   @id @default(uuid())
  tenantId     String
  riderId      String
  lat          Float
  lng          Float
  speed        Float?
  batteryLevel Int?
  timestamp    DateTime @default(now())

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rider        User     @relation("RiderPings", fields: [riderId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([riderId])
}

// ----------------------------------------------------
// 9. BREAKAGE & WASTAGE
// ----------------------------------------------------
model BreakageWastageLog {
  id                 String   @id @default(uuid())
  tenantId           String
  productId          String
  warehouseId        String?
  qty                Int
  unitCost           Float    @default(0)
  totalCost          Float    @default(0)
  reason             String   // bottle_damage, milk_spoilage, oil_spill, cylinder_leak, expired, transport_loss
  liabilityType       String   @default("company") // company, rider
  responsibleRiderId String?
  reportedById       String
  notes              String?
  createdAt          DateTime @default(now())

  tenant             Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product            Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse          Warehouse? @relation(fields: [warehouseId], references: [id])
  reportedBy         User       @relation("ReportedBy", fields: [reportedById], references: [id])
  responsibleRider   User?      @relation("ResponsibleRider", fields: [responsibleRiderId], references: [id])

  @@index([tenantId])
  @@index([productId])
  @@index([warehouseId])
}

// ----------------------------------------------------
// 10. NOTIFICATIONS & MESSAGING
// ----------------------------------------------------
model MessageTemplate {
  id           String   @id @default(uuid())
  tenantId     String
  name         String
  eventTrigger String   // out_for_delivery, delivered, invoice_generated, payment_received, sleeping_alert, custom
  channel      String   @default("whatsapp") // sms, whatsapp, both
  body         String
  status       String   @default("active") // active, inactive
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model MessageLog {
  id             String   @id @default(uuid())
  tenantId       String
  customerId     String?
  templateId     String?
  channel        String   @default("whatsapp") // sms, whatsapp
  recipientPhone String
  body           String
  status         String   @default("sent") // queued, sent, failed
  sentAt         DateTime @default(now())
  errorMessage   String?

  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([customerId])
}

// ----------------------------------------------------
// 11. PRODUCTION & QC BATCHES
// ----------------------------------------------------
model ProductionBatch {
  id                 String   @id @default(uuid())
  tenantId           String
  warehouseId        String
  finishedProductId  String
  bomId              String?
  batchNumber        String
  industryType       String   @default("water") // water, oil, milk, lpg
  inputQty           Float    @default(0.0)
  outputQty          Float
  laborOverheadCost  Float    @default(0.0)
  totalMaterialCost  Float    @default(0.0)
  unitCost           Float    @default(0.0)
  status             String   @default("completed") // planned, in_progress, completed, cancelled
  qualityPassed      Boolean  @default(true)
  tdsLevel           Float?   // Water TDS (ppm)
  phLevel            Float?   // Water Ph
  viscosityGrade     String?  // Oil viscosity
  notes              String?
  producedById       String
  createdAt          DateTime @default(now())

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse       Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  finishedProduct Product          @relation(fields: [finishedProductId], references: [id], onDelete: Cascade)
  bom             BillOfMaterials? @relation(fields: [bomId], references: [id])
  producedBy      User             @relation(fields: [producedById], references: [id], onDelete: Cascade)

  @@unique([tenantId, batchNumber])
  @@index([tenantId])
  @@index([warehouseId])
  @@index([finishedProductId])
}

// ----------------------------------------------------
// 13. PROCUREMENT, VENDORS & BILL OF MATERIALS (BOM)
// ----------------------------------------------------
model Vendor {
  id             String   @id @default(uuid())
  tenantId       String
  name           String
  phone          String?
  email          String?
  address        String?
  taxId          String?
  paymentTerms   String   @default("net_30") // cash_on_delivery, net_15, net_30, net_60
  balancePayable Float    @default(0.0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrders  PurchaseOrder[]
  paymentVouchers PaymentVoucher[]
  ledgers         Ledger[]

  @@index([tenantId])
}

model PurchaseOrder {
  id                   String              @id @default(uuid())
  tenantId             String
  vendorId             String
  poNumber             String
  status               String              @default("issued") // draft, issued, received_partial, received_full, cancelled
  totalAmount          Float               @default(0.0)
  expectedDeliveryDate DateTime?
  notes                String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendor        Vendor              @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  items         PurchaseOrderItem[]
  goodsReceipts GoodsReceipt[]

  @@unique([tenantId, poNumber])
  @@index([tenantId])
  @@index([vendorId])
}

model PurchaseOrderItem {
  id          String   @id @default(uuid())
  poId        String
  productId   String
  expectedQty Int
  unitPrice   Float
  totalPrice  Float

  po          PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  product     Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([poId])
  @@index([productId])
}

model GoodsReceipt {
  id           String             @id @default(uuid())
  tenantId     String
  poId         String
  grnNumber    String
  receivedDate DateTime           @default(now())
  notes        String?
  createdAt    DateTime           @default(now())

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  po        PurchaseOrder      @relation(fields: [poId], references: [id], onDelete: Cascade)
  items     GoodsReceiptItem[]

  @@unique([tenantId, grnNumber])
  @@index([tenantId])
  @@index([poId])
}

model GoodsReceiptItem {
  id          String @id @default(uuid())
  grnId       String
  productId   String
  expectedQty Int
  receivedQty Int
  rejectedQty Int    @default(0)
  unitCost    Float
  totalCost   Float

  grn     GoodsReceipt @relation(fields: [grnId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([grnId])
  @@index([productId])
}

model BillOfMaterials {
  id                String            @id @default(uuid())
  tenantId          String
  finishedProductId String
  name              String
  yieldQty          Float             @default(1.0)
  status            String            @default("active") // active, archived
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  finishedProduct Product           @relation("FinishedProductBOM", fields: [finishedProductId], references: [id], onDelete: Cascade)
  items           BOMItem[]
  batches         ProductionBatch[]

  @@index([tenantId])
  @@index([finishedProductId])
}

model BOMItem {
  id           String   @id @default(uuid())
  bomId        String
  rawProductId String
  qtyRequired  Float

  bom        BillOfMaterials @relation(fields: [bomId], references: [id], onDelete: Cascade)
  rawProduct Product         @relation(fields: [rawProductId], references: [id], onDelete: Cascade)

  @@index([bomId])
  @@index([rawProductId])
}

// ----------------------------------------------------
// 12. SUPER ADMIN & SAAS SUBSCRIPTION PAYMENTS
// ----------------------------------------------------
model SubscriptionPayment {
  id              String   @id @default(uuid())
  tenantId        String
  amount          Float
  planTier        String   @default("starter") // starter, professional, enterprise
  paymentDate     DateTime @default(now())
  paymentMethod   String   @default("bank_transfer") // bank_transfer, credit_card, cash, check
  referenceNumber String?
  status          String   @default("paid") // paid, pending, failed
  notes           String?
  createdAt       DateTime @default(now())

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}
